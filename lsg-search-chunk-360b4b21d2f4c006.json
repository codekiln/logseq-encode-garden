y Dong Tiffany Dong"]],["AI/ES/25/ws/","source-block-2995","Workshop 3 - 2:30pm-3:50pm",["Workshop Schedule"]],["AI/ES/25/ws/","source-block-3027","Company: LangChain",["Workshop Schedule","Workshop 3 - 2:30pm-3:50pm"]],["AI/ES/25/ws/","source-block-3058","Presenter: Person/Nick Huang Nick Huang",["Workshop Schedule","Workshop 3 - 2:30pm-3:50pm","Company: LangChain"]],["AI/ES/25/ws/","source-block-3152","AI/ES/25/ws/3/How Clay Performs Agent Evaluation",["Workshop 3 - 2:30pm-3:50pm","Company: LangChain","Presenter: Person/Nick Huang Nick Huang"]]],"format_version":5}