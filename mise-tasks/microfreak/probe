#!/usr/bin/env bash
#MISE description="Write named settings into a MicroFreak slot, play notes, bend, CCs or pressure, and measure the H5 recording"
#USAGE flag "--base <slot-or-file>" help="Slot to read, or a .bin from microfreak:download"
#USAGE flag "--slot <number>" help="Slot to write the result to and play"
#USAGE flag "--set <name=value>" var=#true help="Stored field to change: an integer choice, a decimal, or raw:N, such as VCO.BendRng=2"
#USAGE flag "--backup-dir <path>" help="Save the slot in a new timestamped folder here first when it holds a preset"
#USAGE flag "--name <name>" help="Preset name to store; default Probe"
#USAGE flag "--script <file>" help="YAML or JSON script of MIDI events"
#USAGE flag "--note <note>" help="Note for the default script; default C4"
#USAGE flag "--velocity <velocity>" help="Velocity for the default script; default 100"
#USAGE flag "--hold <seconds>" help="Seconds the default note is held; default 1.5"
#USAGE flag "--tail <seconds>" help="Seconds recorded after the last event; default 1"
#USAGE flag "--no-write" help="Play --slot as it is"
#USAGE flag "--no-play" help="Write only"
#USAGE flag "--settle <seconds>" help="Seconds between selecting the slot and playing; default 0.4"
#USAGE flag "--device <name>" help="Audio input device; default H5"
#USAGE flag "--input-channel <index>" help="Zero-based audio input channel; default 2"
#USAGE flag "--wav-dir <path>" help="Save the recording here, outside the repository"
#USAGE flag "--output <file>" help="Also write the full report, with every 10 ms frame, here"
#USAGE flag "--frames" help="Print every 10 ms frame, not only the note summaries"
#USAGE flag "--port <name>" help="Exact MIDI port name"
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
exec uv run --no-project --with python-rtmidi==1.5.8 --with sounddevice==0.5.6 --with numpy==2.5.5 --with pyyaml==6.0.2 \
  python "$root/mise-tasks/microfreak/lib/probe.py" "$@"
