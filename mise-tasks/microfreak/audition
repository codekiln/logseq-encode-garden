#!/usr/bin/env bash
#MISE description="Play a MicroFreak slot's sequence, capture its MIDI out and the H5, and report the notes per step as JSON"
#USAGE flag "--slot <number>" help="Preset slot from 1 to 512"
#USAGE flag "--bpm <tempo>" help="Clock tempo; default 120"
#USAGE flag "--loops <count>" help="Times to play the pattern; default 2"
#USAGE flag "--steps <count>" help="Steps per loop; default the slot's Seq.Length"
#USAGE flag "--division <division>" help="Force the step division with CC 92" {
#USAGE   choices "1" "1/2" "1/2T" "1/4" "1/4T" "1/8" "1/8T" "1/16" "1/16T" "1/32" "1/32T"
#USAGE }
#USAGE flag "--plain" help="Send CCs for a simple timbre that is easy to analyse"
#USAGE flag "--cc <number=value>" var=#true help="Extra CC to send after selecting the slot, for example 23=127"
#USAGE flag "--no-midi-out" help="Leave Arp/Seq MIDI Out as it is and rely on audio"
#USAGE flag "--no-audio" help="Skip the H5 recording"
#USAGE flag "--device <name>" help="Audio input device; default H5"
#USAGE flag "--input-channel <index>" help="Zero-based audio input channel; default 2"
#USAGE flag "--wav-dir <path>" help="Directory outside the repository for the WAV"
#USAGE flag "--output <file>" help="Also write the JSON report to this file"
#USAGE flag "--port <name>" help="Exact MIDI port name"
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
exec uv run --no-project --with python-rtmidi==1.5.8 --with sounddevice==0.5.6 --with numpy==2.5.5 \
  python "$root/mise-tasks/microfreak/lib/audition.py" "$@"
