#!/usr/bin/env bash
#MISE description="Write a described sequence into a MicroFreak preset: a new .bin file, a slot, or both"
#USAGE arg "<sequence>" help="JSON or YAML sequence description (see pages/Microfreak___Sequence___Write a sequence.md)"
#USAGE flag "--base <slot-or-file>" help="Preset to start from: a slot number, read without changing it, or a microfreak:download .bin file"
#USAGE flag "--slot <number>" help="Upload the result to this slot and read it back"
#USAGE flag "--output <file>" help="Write the result to this new .bin file"
#USAGE flag "--backup-dir <path>" help="Save the target slot here first; required when it holds a preset"
#USAGE flag "--name <name>" help="Preset name; default the description's name, else the base's"
#USAGE flag "--category <category>" help="Preset category; default the description's, else the base's" {
#USAGE   choices "Bass" "Brass" "Keys" "Lead" "Organ" "Pad" "Percussion" "Sequence" "SFX" "Strings" "Template" "Vocoder"
#USAGE }
#USAGE flag "--port <name>" help="Exact MIDI port name"
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
exec uv run --no-project --with python-rtmidi==1.5.8 --with pyyaml==6.0.2 \
  python "$root/mise-tasks/microfreak/lib/sequence_write.py" "$@"
