#!/usr/bin/env python3
#MISE description="Upload a page-named B2 asset using cached Fnox credentials"
#MISE tools={python="3.13.16", "conda:ffmpeg"="9.0.2"}
#USAGE arg "<source>" help="Prepared local file whose extension matches the asset page" required=#true
#USAGE arg "<page>" help="Existing Owner/Asset/Purpose/format B2 asset page" required=#true
#USAGE flag "--bucket <bucket>" help="Bucket name (defaults to the key's single allowed bucket)"
#USAGE flag "--verify-only" help="Verify an existing object without uploading"
from pathlib import Path
import os
import subprocess
import sys


def main():
    garden = Path(__file__).resolve().parents[3]
    args = [os.environ.get('usage_source', ''), os.environ.get('usage_page', '')]
    if not all(args):
        args = sys.argv[1:]
    else:
        args[0] = str(Path(args[0]).resolve())
        if os.environ.get('usage_bucket'):
            args += ['--bucket', os.environ['usage_bucket']]
        if os.environ.get('usage_verify_only') == 'true':
            args += ['--verify-only']
    sys.path.insert(0, str(Path(__file__).with_name('lib')))
    from cached_credentials import run_cached
    command = [sys.executable, str(Path(__file__).with_name('lib') / 'b2_upload.py'),
               '--garden', str(garden), *args]
    try:
        raise SystemExit(run_cached(command, garden))
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        sys.exit(f'error: {error}')



if __name__ == '__main__':
    main()
