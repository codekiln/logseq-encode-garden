#!/usr/bin/env python3
#MISE description="Transcribe a selected recording with MLX Whisper on Apple Silicon macOS"
#MISE tools={python="3.13.16", uv="0.12.22", "pypi:mlx-whisper"="0.4.3"}
#USAGE arg "<recording>" help="Selected audio recording to transcribe"
#USAGE flag "--output-dir <output_dir>" required=#true help="Directory for commentary.json"
#USAGE flag "--model <model>" default="mlx-community/whisper-large-v3-turbo" help="Local model directory or MLX Whisper model"

"""Transcribe selected audio; recognition output needs a listening review."""

import argparse
import os
from pathlib import Path
import platform
import subprocess
import sys


def transcribe(recording: Path, output_dir: Path, model: str) -> Path:
    if platform.system() != "Darwin" or platform.machine() != "arm64":
        raise ValueError("MLX Whisper requires macOS Apple Silicon")
    if not recording.is_file():
        raise ValueError(f"Recording not found: {recording}")
    output = output_dir / "commentary.json"
    if output.exists():
        raise ValueError(f"Transcript already exists: {output}")
    output_dir.mkdir(parents=True, exist_ok=True)
    subprocess.run(
        ["mlx_whisper", str(recording), "--model", model, "--language", "en",
         "--condition-on-previous-text", "False", "--verbose", "False",
         "--output-format", "json", "--output-name", "commentary", "--output-dir", str(output_dir)],
        check=True,
    )
    if not output.is_file():
        raise ValueError("Whisper did not produce commentary.json")
    return output


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("recording", type=Path)
    parser.add_argument("--output-dir", type=Path, required=True)
    parser.add_argument("--model", default="mlx-community/whisper-large-v3-turbo")
    arguments = sys.argv[1:]
    if "usage_recording" in os.environ:
        arguments = [os.environ["usage_recording"], "--output-dir", os.environ["usage_output_dir"],
                     "--model", os.environ.get("usage_model", "mlx-community/whisper-large-v3-turbo")]
    args = parser.parse_args(arguments)
    try:
        output = transcribe(args.recording, args.output_dir, args.model)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        parser.exit(1, f"error: {error}\n")
    print(f"Transcript: {output}")


if __name__ == "__main__":
    main()
