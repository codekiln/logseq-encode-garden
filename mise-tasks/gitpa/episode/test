    def test_existing_assets_and_handoff_are_preserved_before_inspection(self):
        for existing in ("Session Assets.md", "handoff.json"):
            with self.subTest(existing=existing), tempfile.TemporaryDirectory() as temporary:
                project, garden, note = self.fixture(Path(temporary))
                output = garden / "assets" / "GitP" / "Session" / "2026" / "09" / "24"
                output.mkdir(parents=True)
                destination = garden / "pages" / "GitP___Session___26___09___24 Thu___Session Assets.md" if existing == "Session Assets.md" else output / existing
                original = "tags:: [[Protected]]\n- Human edits\n"
                destination.write_text(original)
                with patch("gitp_episode_draft.duration_seconds") as inspect:
                    with self.assertRaisesRegex(ValueError, "Output already exists"):
                        draft(project, garden, note)
                    inspect.assert_not_called()
                self.assertEqual(destination.read_text(), original)
                self.assertEqual(len(list(output.iterdir())), 0 if existing == "Session Assets.md" else 1)

