    def test_asset_inventory_lists_relative_candidates_without_changing_sources(self):
        with tempfile.TemporaryDirectory() as temporary:
            project, garden, note = self.fixture(Path(temporary))
            candidates = {"Samples/Recorded/mystery.wav": b"wav", "Samples/Recorded/part.aif": b"aif",
                          "Samples/Recorded/other.aiff": b"aiff", "patches/program.mfpz": b"patch",
                          "clips/sequence.mid": b"midi", "clips/other.midi": b"midi", "ignore.asd": b"analysis"}
            for relative, content in candidates.items():
                target = project / relative
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(content)
            before = {path.relative_to(project).as_posix(): path.read_bytes() for path in project.rglob("*") if path.is_file()}
            inventory = dict((name, category) for category, name in session_assets(project))
            self.assertEqual(inventory["Samples/Recorded/mystery.wav"], "WAV audio")
            self.assertEqual(inventory["Samples/Recorded/part.aif"], "AIFF audio")
            self.assertEqual(inventory["Samples/Recorded/other.aiff"], "AIFF audio")
            self.assertEqual(inventory["patches/program.mfpz"], "MicroFreak patch")
            self.assertEqual(inventory["clips/sequence.mid"], "MIDI file")
            self.assertEqual(inventory["clips/other.midi"], "MIDI file")
            self.assertEqual(inventory["Session.als"], "Ableton set")
            self.assertNotIn("ignore.asd", inventory)
            with patch("gitp_episode_draft.duration_seconds", return_value=180):
                output, handoff = draft(project, garden, note)
            text = output.read_text()
            self.assertTrue(text.startswith("- # Session Assets\n"))
            self.assertIn("\t- ## Available files\n", text)
            self.assertIn("\t\t- WAV audio: `Samples/Recorded/mystery.wav`.", text)
            self.assertNotIn(str(project), text)
            self.assertEqual(before, {path.relative_to(project).as_posix(): path.read_bytes() for path in project.rglob("*") if path.is_file()})

