    def test_optional_transcription_invokes_its_mise_dependency_task(self):
        with patch("gitp_episode_draft.platform.system", return_value="Darwin"), patch("gitp_episode_draft.platform.machine", return_value="arm64"), patch("gitp_episode_draft.subprocess.run") as command, patch("gitp_episode_draft.transcript_quality", return_value=(False, "Repeated phrases")):
            self.assertEqual(transcribe_stem(Path("commentary.aif"), "model"), (False, "Repeated phrases"))
        arguments = command.call_args_list[1].args[0]
        self.assertEqual(arguments[:4], ["mise", "run", "gitpa:episode:transcribe", "--"])
        self.assertNotIn("--with", arguments)
        self.assertEqual(command.call_args_list[1].kwargs["cwd"], MODULE.ROOT)
        self.assertNotIn("--offline", arguments)

    def test_optional_task_declares_whisper_and_preserves_existing_output(self):
        task = TASK.with_name("transcribe")
        self.assertIn('"pypi:mlx-whisper"="0.4.3"', task.read_text())
        self.assertNotIn('pypi:mlx-whisper', TASK.read_text())
        loader = SourceFileLoader("gitp_episode_transcribe", str(task))
        spec = spec_from_loader(loader.name, loader)
        module = module_from_spec(spec)
        loader.exec_module(module)
        with tempfile.TemporaryDirectory() as temporary:
            root = Path(temporary)
            audio = root / "audio.wav"
            audio.write_bytes(b"selected recording")
            output = root / "commentary.json"
            output.write_text("Reviewed recognition")
            with patch.object(module.platform, "system", return_value="Darwin"), patch.object(module.platform, "machine", return_value="arm64"), patch.object(module.subprocess, "run") as run:
                with self.assertRaisesRegex(ValueError, "already exists"):
                    module.transcribe(audio, root, "model")
                run.assert_not_called()
                self.assertEqual(output.read_text(), "Reviewed recognition")

    def test_optional_task_runs_declared_whisper_executable_and_json_flags(self):
        loader = SourceFileLoader("gitp_episode_transcribe", str(TASK.with_name("transcribe")))
        module = module_from_spec(spec_from_loader(loader.name, loader))
        loader.exec_module(module)
        with tempfile.TemporaryDirectory() as temporary:
            root = Path(temporary)
            audio = root / "audio.wav"
            audio.write_bytes(b"selected recording")
            def recognize(arguments, **kwargs):
                (root / "commentary.json").write_text('{"segments": []}')
            with patch.object(module.platform, "system", return_value="Darwin"), patch.object(module.platform, "machine", return_value="arm64"), patch.object(module.subprocess, "run", side_effect=recognize) as run:
                result = module.transcribe(audio, root, "model")
            arguments = run.call_args.args[0]
            self.assertEqual(arguments[:2], ["mlx_whisper", str(audio)])
            self.assertEqual(arguments[arguments.index("--output-name") + 1], "commentary")
            self.assertEqual(arguments[arguments.index("--output-format") + 1], "json")
            self.assertEqual(result, root / "commentary.json")
            self.assertEqual(audio.read_bytes(), b"selected recording")

