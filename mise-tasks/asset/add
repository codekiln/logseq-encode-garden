#!/usr/bin/env bash
#MISE description="Track a page-named local asset"
#MISE tools={uv="0.12.22", python="3.13.16"}
#USAGE arg "<source>"
#USAGE arg "<page>"
set -euo pipefail
root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
if [[ -n "${usage_source:-}" ]]; then
  set -- "$usage_source" "$usage_page"
fi
exec uv run --project "$root/mise-tasks/asset" python "$root/mise-tasks/asset/lib/assets.py" "add" "$@"
