#!/usr/bin/env bash
#MISE description="Rebuild an MP3 when its WAV changes"
#MISE tools={uv="0.12.22", python="3.13.16", "conda:ffmpeg"="9.0.2"}
#USAGE arg "<wav_page>"
#USAGE arg "<mp3_page>"
set -euo pipefail
root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
if [[ -n "${usage_wav_page:-}" ]]; then
  set -- "$usage_wav_page" "$usage_mp3_page"
fi
exec uv run --project "$root/mise-tasks/asset" python "$root/mise-tasks/asset/lib/assets.py" "convert" "$@"
