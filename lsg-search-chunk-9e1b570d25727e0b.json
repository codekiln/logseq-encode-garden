ks"]],["Bibio/Music/Recording/The%20Apple%20and%20the%20Tooth/","source-block-581","07 - dwrcan",["The Apple and the Tooth","Tracks"]],["Bibio/Music/Recording/The%20Apple%20and%20the%20Tooth/","source-block-597","08 - lovers carvings",["The Apple and the Tooth","Tracks"]],["Bibio/Music/Recording/The%20Apple%20and%20the%20Tooth/","source-block-622","09 - haikuesque (whispers in the rain mix)",["The Apple and the Tooth","Tracks"]],["Bibio/Music/Recording/The%20Apple%20and%20the%20Tooth/","source-block-669","10 - all the flowers",["The Apple and the Tooth","Tracks"]],["Bibio/Music/Recording/The%20Apple%20and%20the%20Tooth/","source-block-694","11 - fire ant",["The Apple and the Tooth","Tracks"]],["Bibio/Music/Recording/The%20Apple%20and%20the%20Tooth/","source-block-712","12 - palm of your wave (bibio remix)",["The Apple and the Tooth","Tracks"]],["Binary/Cache/","source-block-96","Binary Cache",[]],["Binary/Cache/","source-block-113","A binary cache is a cache of already-built artifacts, so a system can download trusted build outputs instead of rebuilding the same derivations locally.",["Binary Cache"]],["Binary/Cache/","source-block-269","In Nix, binary caches are one of the practical levers that make reproducible builds usable day to day: CI can build once, publish the result, and developer machines or deploy targets can fetch the matching store paths later.",["Binary Cache"]],["Binary/Cache/","source-block-501","Cachix is centered on hosted Nix binary cache sharing.",["Binary Cache"]],["Binary/Cache/","source-block-563","DeterminateSystems offers binary-cache features through FlakeHub Cache.",["Binary Cache"]],["BiomeJS/","source-block-61","BiomeJS Conceptual Overview",[]],["BiomeJS/","source-block-93","Overview",["BiomeJS Conceptual Overview"]],["BiomeJS/","source-block-108","BiomeJS is a comprehensive web development toolchain that combines formatting, linting, and code analysis into a single, fast tool",["BiomeJS Conceptual Overview","Overview"]],["BiomeJS/","source-block-243","Built with Rust for performance, designed as a unified replacement for multiple tools like ESLint, Prettier, and other JavaScript tooling",["BiomeJS Conceptual Overview","Overview"]],["BiomeJS/","source-block-385","Aims to be \"one toolchain for your web project\" with a focus on speed, simplicity, and scalability",["BiomeJS Conceptual Overview","Overview"]],["BiomeJS/","source-block-488","Context",["BiomeJS Conceptual Overview"]],["BiomeJS/","source-block-502","JavaScript ecosystem traditionally requires multiple tools: ESLint for linting, Prettier for formatting, various plugins for different file types",["BiomeJS Conceptual Overview","Context"]],["BiomeJS/","source-block-652","This fragmentation leads to:",["BiomeJS Conceptual Overview","Context"]],["BiomeJS/","source-block-685","Configuration complexity across multiple tools",["BiomeJS Conceptual Overview","Context","This fragmentation leads to:"]],["BiomeJS/","source-block-737","Performance overhead from running separate processes",["BiomeJS Conceptual Overview","Context","This fragmentation leads to:"]],["BiomeJS/","source-block-795","Inconsistent behavior between tools",["BiomeJS Conceptual Overview","Context","This fragmentation leads to:"]],["BiomeJS/","source-block-836","Maintenance burden of keeping tools compatible",["BiomeJS Conceptual Overview","Context","This fragmentation leads to:"]],["BiomeJS/","source-block-888","BiomeJS emerged to consolidate these tools into a single, performant solution",["BiomeJS Conceptual Overview","Context"]],["BiomeJS/","source-block-970","Inspired by rust-analyzer's architecture for language tooling",["BiomeJS Conceptual Overview","Context"]],["BiomeJS/","source-block-1036","Key Principles",["BiomeJS Conceptual Overview"]],["BiomeJS/","source-block-1057","Unified Toolchain - Single tool handles formatting, linting, and code analysis",["BiomeJS Conceptual Overview","Key Principles"]],["BiomeJS/","source-block-1144","Performance First - Built in Rust, approximately 35x faster than Prettier",["BiomeJS Conceptual Overview","Key Principles"]],["BiomeJS/","source-block-1226","Zero Configuration - Works out of the box with sensible defaults",["BiomeJS Conceptual Overview","Key Principles"]],["BiomeJS/","source-block-1299","Compatibility - 97% compatible with Prettier, includes 360+ rules from ESLint ecosystem",["BiomeJS Conceptual Overview","Key Principles"]],["BiomeJS/","source-block-1395","Scalability - Designed to handle projects of any size efficiently",["BiomeJS Conceptual Overview","Key Principles"]],["BiomeJS/","source-block-1469","Actionable Diagnostics - Provides detailed, contextual error messages",["BiomeJS Conceptual Overview","Key Principles"]],["BiomeJS/","source-block-1547","Mechanism",["BiomeJS Conceptual Overview"]],["BiomeJS/","source-block-1563","Architecture",["BiomeJS Conceptual Overview","Mechanism"]],["BiomeJS/","source-block-1584","Built in Rust for native performance",["BiomeJS Conceptual Overview","Mechanism","Architecture"]],["BiomeJS/","source-block-1626","Single binary handles multiple operations",["BiomeJS Conceptual Overview","Mechanism","Architecture"]],["BiomeJS/","source-block-1673","Inspired by rust-analyzer's innovative language tooling approach",["BiomeJS Conceptual Overview","Mechanism","Architecture"]],["BiomeJS/","source-block-1743","Can process multiple file types through unified API",["BiomeJS Conceptual Overview","Mechanism","Architecture"]],["BiomeJS/","source-block-1800","Operations",["BiomeJS Conceptual Overview","Mechanism"]],["BiomeJS/","source-block-1819","Formatting: Reformats code to consistent style (97% Prettier-compatible)",["BiomeJS Conceptual Overview","Mechanism","Operations"]],["BiomeJS/","source-block-1901","Linting: Checks code against 360+ rules from ESLint and TypeScript ESLint",["BiomeJS Conceptual Overview","Mechanism","Operations"]],["BiomeJS/","source-block-1984","Check: Single command (biome check) runs all operations together",["BiomeJS Conceptual Overview","Mechanism","Operations"]],["BiomeJS/","source-block-2060","Supported Languages",["BiomeJS Conceptual Overview","Mechanism"]],["BiomeJS/","source-block-2088","JavaScript, TypeScript, JSX, TSX",["BiomeJS Conceptual Overview","Mechanism","Supported Languages"]],["BiomeJS/","source-block-2126","JSON",["BiomeJS Conceptual Overview","Mechanism","Supported Languages"]],["BiomeJS/","source-block-2136","HTML, CSS",["BiomeJS Conceptual Overview","Mechanism","Supported Languages"]],["BiomeJS/","source-block-2151","GraphQL",["BiomeJS Conceptual Overview","Mechanism","Supported Languages"]],["BiomeJS/","source-block-2164","Examples",["BiomeJS Conceptual Overview"]],["BiomeJS/","source-block-2179","Basic Usage",["BiomeJS Conceptual Overview","Examples"]],["BiomeJS/","source-block-2360","Configuration",["BiomeJS Conceptual Overview","Examples"]],["BiomeJS/","source-block-2382","Zero configuration required to start",["BiomeJS Conceptual Overview","Examples","Configuration"]],["BiomeJS/","source-block-2424","Optional biome.json for customization:",["BiomeJS Conceptual Overview","Examples","Configuration"]]],"format_version":5}